# === DiffusionBot Configuration ===

# Environment
DIFFBOT_ENVIRONMENT=production
DIFFBOT_DEBUG=false

# Database
DIFFBOT_DATABASE_URL=sqlite:///data/diffusionbot.db

# API Server
DIFFBOT_API_HOST=0.0.0.0
DIFFBOT_API_PORT=8420
DIFFBOT_WEBHOOK_SECRET=your-webhook-secret-here

# Claude API (Anthropic)
DIFFBOT_ANTHROPIC_API_KEY=sk-ant-...
DIFFBOT_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Telegram Bot
DIFFBOT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
DIFFBOT_TELEGRAM_CHAT_ID=your-chat-id

# Moz API (free tier)
DIFFBOT_MOZ_ACCESS_ID=
DIFFBOT_MOZ_SECRET_KEY=

# Google OAuth (GA4 + GSC)
DIFFBOT_GOOGLE_SERVICE_ACCOUNT_FILE=
DIFFBOT_GOOGLE_CLIENT_ID=
DIFFBOT_GOOGLE_CLIENT_SECRET=

# Encryption key for platform credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DIFFBOT_FERNET_KEY=your-fernet-key-here

# Limits
DIFFBOT_MAX_POSTS_PER_DAY_GLOBAL=10
DIFFBOT_MAX_RETRIES=3
DIFFBOT_REQUEST_TIMEOUT=30
